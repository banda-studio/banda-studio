# Sanity — copiar a .env.local y completar valores
# Estos vars son públicos (prefijo NEXT_PUBLIC_) — proyecto y dataset son
# visibles en el dashboard de sanity.io/manage y no son secretos.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Si en el futuro agregamos read tokens (drafts/preview), van acá SIN prefijo:
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=
